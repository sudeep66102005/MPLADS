# Copy to .env and fill in real values before running against a real database.

# ── Database ─────────────────────────────────────────────────────────────
# Default matches the docker-compose.yml PostgreSQL service.
DATABASE_URL=postgresql+psycopg://mplads:mplads@localhost:5432/mplads_ai

# ── JWT / Auth ───────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production-use-a-strong-random-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the frontend.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:3001
