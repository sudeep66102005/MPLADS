# Copy to .env. SQLite is convenient for local development.
DATABASE_URL=sqlite:///./mplads.db
# Replace with a long random secret; required in production.
JWT_SECRET_KEY=replace-with-at-least-32-random-private-characters
ENVIRONMENT=development
CORS_ALLOW_ORIGINS=http://localhost:3000,https://sudeep66102005.github.io
UPLOAD_DIR=./data/uploads
AUTO_CREATE_TABLES=false
DEMO_MODE=false
# Compose only: use URL-safe characters for this password.
POSTGRES_PASSWORD=replace-with-a-private-url-safe-password
